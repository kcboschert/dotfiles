{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "plan": "allow",
    "skill": "allow",
    "read": "allow",
    "read:*.env": "deny",
    "read:*.env.*": "deny",
    "read:*.env.example": "allow",
    "edit": "ask",
    "edit:*.lock": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "write": "ask",
    "agent": "allow",
    "get_subagent_result": "allow",
    "steer_subagent": "allow"
  },
  "bash": {
    "*": "ask",
    "read *": "deny", // some models try this instead of the read tool
    "cat *": "allow",
    "cksum *": "allow",
    "cmp *": "allow",
    "comm *": "allow",
    "date *": "allow",
    "diff *": "allow",
    "df *": "allow",
    "du *": "allow",
    "echo *": "allow",
    "egrep *": "allow",
    "env *": "deny",
    "fgrep *": "allow",
    "file *": "allow",
    "find *": "allow",
    "find *-exec*": "ask",
    "find *-ok*": "ask",
    "find *-x*": "ask",
    "find *-X*": "ask",
    "git branch *": "allow",
    "git branch *-d*": "ask",
    "git branch *-D*": "ask",
    "git diff *": "allow",
    "git log *": "allow",
    "git rev-parse *": "allow",
    "git show *": "allow",
    "git status *": "allow",
    "grep *": "allow",
    "head *": "allow",
    "hostname": "allow",
    "id *": "allow",
    "less *": "allow",
    "ls *": "allow",
    "md5sum *": "allow",
    "ps *": "allow",
    "printenv *": "deny",
    "pwd": "allow",
    "rg *" : "allow",
    "sha1sum *": "allow",
    "sha256sum *": "allow",
    "sort *": "allow",
    "stat *": "allow",
    "tail *": "allow",
    "tree *": "allow",
    "type *": "allow",
    "uname *": "allow",
    "uniq *": "allow",
    "uptime": "allow",
    "wc *": "allow",
    "which *": "allow",
    "whoami": "allow"
  },
  "mcp": {
    "*": "ask"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "doom_loop": "ask",
    "external_directory": "ask",
    "external_directory:~/.pi/agent/skills/*": "allow",
    "external_directory:~/.pi/agent/git/github.com/obra/superpowers/skills/*": "allow",
    "external_directory:~/.ssh/*": "deny"
  }
}
