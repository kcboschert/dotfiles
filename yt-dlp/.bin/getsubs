#!/usr/bin/env bash

set -o nounset -o pipefail -o errexit

tmpfile=$(mktemp)
format="lrc"

trap 'rm -f ${tmpfile}; rm -f ${tmpfile}.en.${format}' EXIT

yt-dlp \
  --skip-download \
  --write-subs \
  --sub-lang en \
  --output "${tmpfile}" \
  --convert-subs ${format} \
  "$@"

# if there weren't any subs available, get the auto-generated ones
if [ ! -f "${tmpfile}.en.${format}" ]; then
  yt-dlp \
    --skip-download \
    --write-auto-sub \
    --sub-lang en \
    --output "${tmpfile}" \
    --convert-subs ${format} \
    "$@"
fi

cat "${tmpfile}.en.${format}"
